rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "4Kv4dvuYk5RQ7pMVdlCGo0k4uWj1";
    }

    function isInvoiceOperator() {
      return request.auth != null && (
        request.auth.uid == "MdDo23wttDTL5d92XFCwg8vQaK52" ||
        request.auth.uid == "QN9bzKx9HoYa8cQsd5HC7d4r66q1" ||
        request.auth.uid == "ti0nxmb1dkfc5vNJ62D3P25bJEw1"
      );
    }

    function validInvoicePdf() {
      return request.resource == null || (
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType == "application/pdf"
      );
    }

    match /registro-mozzanica/fatture-acquisto/{allPaths=**} {
      allow read: if isAdmin() || isInvoiceOperator();
      allow write: if (isAdmin() || isInvoiceOperator()) && validInvoicePdf();
    }

    match /registro-mozzanica/fatture-vendita/{allPaths=**} {
      allow read: if isAdmin() || isInvoiceOperator();
      allow write: if (isAdmin() || isInvoiceOperator()) && validInvoicePdf();
    }

    match /registro-mozzanica/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
